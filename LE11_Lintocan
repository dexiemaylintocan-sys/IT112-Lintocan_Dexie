#include<stdio.h>

int main () {

    FILE *fp;
    int idNumber;
    char name[100];
    char section[100];
    char record[100];
    int choice;

    do {
        fp = fopen("student_records.txt", "a+");

        if (fp == NULL) {
            printf("Error opening file!\n");
            return 1;
        }

        printf("Enter Student Number: ");
        scanf("%d", &idNumber);
        getchar();

        printf("Enter Complete Name: ");
        fgets(name, sizeof(name), stdin);

        printf("Enter Section: ");
        scanf("%s", section);

        fprintf(fp, "ID Number: %d\n", idNumber);
        fprintf(fp, "Complete Name: %s", name);
        fprintf(fp, "Section: %s\n\n", section);

        printf("\nRecord added and saved successfully.\n");

        fclose(fp);

        printf("\nAdd another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);

        printf("\n");

    } while (choice == 1);

    fp = fopen("student_records.txt", "a+");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    printf("All student records have been saved.\n");

    rewind(fp);

    while (fgets(record, sizeof(record), fp))

    {
        printf("%s", record);
    }

    fclose(fp);

    return 0;
}
